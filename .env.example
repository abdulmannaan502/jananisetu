# JananiSetu — Environment Configuration
# Copy this file to .env and customize for your deployment.

# Database Connection (PostgreSQL primary; SQLite supported for local fallback/testing)
JANANI_DB_URL=postgresql+psycopg://janani:janani_secure_pass@localhost:5432/jananisetu
# Fallback SQLite directory when JANANI_DB_URL is not set to PostgreSQL
JANANI_DATA_DIR=./data

# Authentication & Security
JANANI_JWT_SECRET=change-this-to-a-cryptographically-random-secret-key-min-32-chars
JANANI_JWT_ALGORITHM=HS256
JANANI_ACCESS_TOKEN_EXPIRE_MINUTES=480
JANANI_ALLOW_LEGACY_HEADER=true

# Application Environment
JANANI_ENV=development
JANANI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
JANANI_SEED_DEMO_DATA=true

